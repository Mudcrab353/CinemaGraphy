{
  "name": "cinemagraphy",
  "version": "3.2.1",
  "packageManager": "pnpm@11.11.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env ./index.js",
    "dev-proxy": "node --env-file=.env ./proxyServer.js",
    "start": "node --env-file=.env ./index.js",
    "start-proxy": "node --env-file=.env ./proxyServer.js",
    "worker:dev": "wrangler dev",
    "worker:secrets": "node ./scripts/upload-worker-secrets.js",
    "worker:deploy": "wrangler deploy --secrets-file .dev.vars",
    "worker:check": "wrangler deploy --dry-run --secrets-file .dev.vars",
    "test": "node --test",
    "check": "node --check index.js && node --check proxyServer.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "CinemaGraphy Stremio addon",
  "engines": {
    "node": ">=20"
  }
}
