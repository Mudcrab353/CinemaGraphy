# =============================================================================
# CinemaGraphy — PUBLIC .env template (safe to share / put in Git as example)
# نسخهٔ عمومی — بدون رمز و کلید واقعی. برای self-host یا راهنما.
# Copy to .env and fill only what you need.
# =============================================================================

# --- Core ---
LOG_LEVEL=info
DEV_MODE=false
PORT=7000
# PUBLIC_BASE_URL=https://your-domain.example

# --- Language defaults (optional; configure page can override) ---
# ADDON_LANG=fa
# META_LANG=fa
# ADDON_NAME_SUFFIX=

# --- TMDB (required for Persian meta + posters) ---
# Free key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# TMDB_CACHE_TTL_MS=3600000

# --- Iranian stream providers (BASEURL only; leave empty to disable) ---
# F2 has a built-in default if unset: https://www.film2med.top
F2MEDIA_BASEURL=https://www.film2med.top
ENABLE_F2_TURKISH=1

CINAMATIC_BASEURL=
ASLMOVIEZ_BASEURL=
SERIALBLOG_BASEURL=
DONYAYESERIAL_BASEURL=
ANIMEX_BASEURL=

# Optional / locked on public configure UI on production:
PEEPBOXTV_BASEURL=
PEEPBOXTV_USER_ID=
PEEPBOXTV_ANDROID_ID=
PEEPBOXTV_API_KEY=

DIGIMOVIE_BASEURL=
DIGIMOVIE_USERNAME=
DIGIMOVIE_PASSWORD=
# Prefer cookie over password to avoid login puzzles on every cold start
DIGIMOVIE_COOKIE=
AVAMOVIE_BASEURL=
AVAMOVIE_USERNAME=
AVAMOVIE_PASSWORD=
AVAMOVIE_COOKIE=

# Namakade — only when ENABLE_NAMAKADE=1
# ENABLE_NAMAKADE=0
# NAMAKADE_BASEURL=https://namakade.com

# --- External catalogs (full …/manifest.json URLs) ---
CATALOG101_MANIFEST_URL=https://api.101catalogs.xyz/t0-free/lists/000vBfBg4q4l4s4y4k4u4o5m504w5PBtBs0x044r4m4t4z4n4v4p515n4x5QB0/meta/off/manifest.json
CATALOG_ANIME_MANIFEST_URL=https://1fe84bc728af-stremio-anime-catalogs.baby-beamup.club/manifest.json
CATALOG_IPTVBRIDGE_MANIFEST_URL=https://iptvbridge.vercel.app/manifest.json
# CATALOG_AIO_MANIFEST_URL=
# CATALOG_AIOCATALOGS_MANIFEST_URL=
# CATALOG_TMDB_MANIFEST_URL=
# EXTERNAL_CATALOG_MANIFEST_URLS=

# --- Optional torrent (Meteor / similar Stremio torrent addon) ---
TORRENT_METEOR_MANIFEST_URL=

# --- Timeouts ---
# PROVIDER_TIMEOUT_MS=15000

# --- Cache (new in 3.1.0) ---
CACHE_BACKEND=memory
# CACHE_BACKEND=redis
# REDIS_URL=redis://127.0.0.1:6379
# CACHE_PREFIX=cg:
# CACHE_MEMORY_MAX=2000

# --- Proxy (optional local media proxy) ---
PROXY_ENABLE=false
PROXY_PORT=3005
PROXY_ALLOWED_URLS=metahub.space,imdb.com,strem.io,tmdb.org
PROXY_URL=http://127.0.0.1:3005
PROXY_PATH=proxy

# --- Subtitles (optional SubSource manifest) ---
# SUBSOURCE_MANIFEST_URL=

# Admin panel (VPS) — leave empty to disable
ADMIN_PASSWORD=
# ADMIN_PATH=/admin

# Rate limit (recommended on VPS)
RATE_LIMIT_ENABLED=0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_SEARCH_MAX=30

# Animex anime catalog (default on when ANIMEX_BASEURL set; set 0 to disable)
ENABLE_ANIMEX_CATALOG=1
